_claude_mcp() {
  local -a subcmds
  subcmds=(
    'add:Add an MCP server'
    'add-from-claude-desktop:Import MCP servers from Claude Desktop'
    'add-json:Add an MCP server with a JSON string'
    'get:Get details about an MCP server'
    'list:List configured MCP servers'
    'login:Authenticate with an MCP server'
    'logout:Clear stored OAuth credentials for an MCP server'
    'remove:Remove an MCP server'
    'reset-project-choices:Reset approved/rejected project-scoped servers'
    'serve:Start the Claude Code MCP server'
    'help:Display help for a command'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'claude mcp command' subcmds
    return
  fi
  case ${words[1]} in
    get|login|logout|remove) _claude_mcp_servers ;;
    add)
      _arguments \
        '(-s --scope)'{-s,--scope}'[Configuration scope]:scope:(local user project)' \
        '(-t --transport)'{-t,--transport}'[Transport type]:transport:(stdio sse http)' \
        '*'{-e,--env}'[Set environment variables]:KEY=value:' \
        '*'{-H,--header}'[Set HTTP headers]:header:' \
        '1:name:' '2:command or url:' '*:::args:_normal'
      ;;
    add-json) _arguments '(-s --scope)'{-s,--scope}'[Configuration scope]:scope:(local user project)' '1:name:' '2:json:' ;;
  esac
}

_claude_plugin() {
  local -a subcmds
  subcmds=(
    'details:Show a plugin component inventory and token cost'
    'disable:Disable an enabled plugin'
    'enable:Enable a disabled plugin'
    'eval:Run eval cases against a plugin'
    'init:Scaffold a new plugin'
    'install:Install a plugin from available marketplaces'
    'list:List installed plugins'
    'marketplace:Manage Claude Code marketplaces'
    'prune:Remove auto-installed dependencies no longer needed'
    'tag:Create a release git tag for a plugin'
    'uninstall:Uninstall an installed plugin'
    'update:Update a plugin to the latest version'
    'validate:Validate a plugin or marketplace manifest'
    'help:Display help for a command'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'claude plugin command' subcmds
    return
  fi
  case ${words[1]} in
    details|disable|enable|uninstall|remove|update) _claude_plugins ;;
    validate|tag|eval) _files ;;
  esac
}

_claude() {
  local curcontext="$curcontext" state line ret=1
  local -a commands
  commands=(
    'agents:Manage background agents'
    'attach:Open a background session in this terminal'
    'auth:Manage authentication'
    'auto-mode:Inspect or reset auto mode classifier configuration'
    'doctor:Check the health of your Claude Code installation'
    'gateway:Run the enterprise auth/telemetry gateway'
    'import:Import config from another AI coding agent'
    'install:Install Claude Code native build'
    'logs:Print a background session recent terminal output'
    'mcp:Configure and manage MCP servers'
    'plugin:Manage Claude Code plugins'
    'project:Manage Claude Code project state'
    'respawn:Restart a background session'
    'rm:Delete a background session'
    'setup-token:Set up a long-lived authentication token'
    'stop:Stop a background session'
    'ultrareview:Run a cloud-hosted multi-agent code review'
    'update:Check for updates and install if available'
  )

  _arguments -C $_claude_main_opts '1: :->command' '*:: :->args' && ret=0

  case $state in
    command)
      _alternative \
        'commands:command:{_describe -t commands "claude command" commands}' \
        'prompt:prompt:{_message -e prompt "prompt"}' && ret=0
      ;;
    args)
      case ${words[1]} in
        mcp) _claude_mcp && ret=0 ;;
        plugin|plugins) _claude_plugin && ret=0 ;;
        auth)
          local -a authcmds
          authcmds=(
            'login:Sign in to your Anthropic account'
            'logout:Log out from your Anthropic account'
            'status:Show authentication status'
          )
          _describe -t commands 'claude auth command' authcmds && ret=0
          ;;
        project)
          local -a projcmds
          projcmds=('purge:Delete all Claude Code state for a project')
          _describe -t commands 'claude project command' projcmds && ret=0
          ;;
        attach|logs|stop|kill|rm|respawn) _claude_bg_sessions && ret=0 ;;
        install)
          local -a targets
          targets=('stable:latest stable build' 'latest:latest build')
          _describe -t targets 'target' targets && ret=0
          ;;
        ultrareview) _message -e target 'PR number or base branch' && ret=0 ;;
        *) _arguments $_claude_main_opts && ret=0 ;;
      esac
      ;;
  esac

  return ret
}

_claude "$@"
