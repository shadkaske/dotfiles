#compdef claude
# Completion for Claude Code (https://claude.com/claude-code)

_claude_models() {
  local -a models
  models=(
    'fable:latest Fable model'
    'opus:latest Opus model'
    'sonnet:latest Sonnet model'
    'haiku:latest Haiku model'
    'claude-fable-5-1:Fable 5.1'
    'claude-opus-5:Opus 5'
    'claude-sonnet-5:Sonnet 5'
    'claude-haiku-4-5-20251001:Haiku 4.5'
  )
  _describe -t models 'model' models
}

_claude_sessions() {
  local -a ids
  local dir="${HOME}/.claude/projects/${PWD//\//-}"
  [[ -d $dir ]] || return 1
  ids=(${${(f)"$(print -rl -- $dir/*.jsonl(N:t:r))"}})
  (( $#ids )) && _describe -t sessions 'session' ids
}

_claude_bg_sessions() {
  local -a ids
  if (( $+commands[jq] )); then
    ids=(${(f)"$(claude agents --json 2>/dev/null | jq -r '.[] | "\(.sessionId):\(.name // .kind) (\(.status))"' 2>/dev/null)"})
  else
    ids=(${(f)"$(claude agents --json 2>/dev/null | sed -n 's/.*"sessionId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"})
  fi
  (( $#ids )) && _describe -t sessions 'background session' ids
}

_claude_mcp_servers() {
  local -a servers
  servers=(${(f)"$(claude mcp list 2>/dev/null | awk -F': ' '/ - /{print $1}')"})
  (( $#servers )) && _describe -t servers 'MCP server' servers
}

_claude_plugins() {
  local -a plugins
  plugins=(${(f)"$(claude plugin list 2>/dev/null | sed -n 's/^[[:space:]]*\([A-Za-z0-9_][A-Za-z0-9_@.-]*\).*/\1/p')"})
  (( $#plugins )) && _describe -t plugins 'plugin' plugins
}

_claude_tools() {
  local -a tools
  tools=(
    Agent Bash BashOutput Edit ExitPlanMode Glob Grep KillShell
    NotebookEdit Read Skill SlashCommand Task TodoWrite WebFetch WebSearch Write
  )
  _values -s , 'tool' $tools
}

