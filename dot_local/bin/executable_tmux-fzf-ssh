#!/bin/bash

# Host entries live in ~/.ssh/config.d/; skip wildcard patterns like Host *
SELECTED_HOST=$(grep -hE '^Host ' ~/.ssh/config ~/.ssh/config.d/* 2>/dev/null | awk '{print $2}' | grep -v '[*?!]' | fzf-tmux -p --prompt="SSH Host: ")

if [ -z "$SELECTED_HOST" ]; then
    exit 0
else
    tmux new-window -n "ssh - $SELECTED_HOST" ssh "$SELECTED_HOST"
fi

#vim: set ft=sh:
