#!/usr/bin/env bash
# Claude Code rewrites settings.json (key order, keys it adds itself), which
# made chezmoi report a conflict on every apply. Merge the managed settings
# into the current file instead: existing keys keep their order and anything
# Claude Code added stays; managed values win.
set -euo pipefail
current="$(cat)"
read -r -d '' managed <<'JSON' || true
{
  "model": "opus",
  "theme": "auto",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
{{- /* herdr's Claude integration installs this hook itself; only reference it where it exists. */}}
{{- if stat (joinPath .chezmoi.homeDir ".claude/hooks/herdr-agent-state.sh") }},
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
{{- end }}
}
JSON
if [[ -n $current ]] && jq -e 'type == "object"' >/dev/null 2>&1 <<<"$current"; then
  jq --argjson managed "$managed" '. * $managed' <<<"$current"
else
  jq . <<<"$managed"
fi
