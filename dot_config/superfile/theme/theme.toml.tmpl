# Uses ANSI palette indexes (0-15) instead of hex so superfile follows the
# terminal's colors (Noctalia/WSL/any terminal theme). Empty backgrounds
# leave the terminal's own background showing.
code_syntax_highlight = "{{ .colors.name }}"

# ========= Border =========
file_panel_border = "8"
sidebar_border = "0"
footer_border = "8"

# ========= Border Active =========
file_panel_border_active = "13"
sidebar_border_active = "1"
footer_border_active = "6"
modal_border_active = "6"

# ========= Background (bg) =========
full_screen_bg = ""
file_panel_bg = ""
sidebar_bg = ""
footer_bg = ""
modal_bg = ""

# ========= Foreground (fg) =========
full_screen_fg = "7"
file_panel_fg = "7"
sidebar_fg = "7"
footer_fg = "7"
modal_fg = "7"

# ========= Special Color =========
cursor = "11"
correct = "2"
error = "1"
hint = "6"
cancel = "11"
gradient_color = ["4", "5"]

# ========= File Panel Special Items =========
file_panel_top_directory_icon = "6"
file_panel_top_path = "4"
file_panel_item_selected_fg = "12"
file_panel_item_selected_bg = ""

# ========= Sidebar Special Items =========
sidebar_title = "6"
sidebar_item_selected_fg = "6"
sidebar_item_selected_bg = ""
sidebar_divider = "8"

# ========= Modal Special Items =========
modal_cancel_fg = "0"
modal_cancel_bg = "3"

modal_confirm_fg = "0"
modal_confirm_bg = "2"

# ========= Help Menu =========
help_menu_hotkey = "6"
help_menu_title = "6"
