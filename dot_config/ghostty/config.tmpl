window-padding-x = 4
window-padding-y = 6

{{/* Ubuntu GNOME: Ubuntu Mono 13 at opacity 0.92, installed by the
     work-laptop playbook. It has only Regular/Bold/Italic, so Ghostty's
     default styles. */ -}}
{{ $ubuntuGnome := and (eq .chezmoi.os "linux") (eq (index .chezmoi.osRelease "id") "ubuntu") (lookPath "gnome-shell") -}}
{{ if $ubuntuGnome -}}
font-family = "UbuntuMono Nerd Font Mono"
{{ else -}}
font-family = "JetBrainsMono Nerd Font Mono"
font-style = "Light"
font-style-bold = "SemiBold"
font-style-italic = "Light Italic"
font-style-bold-italic = "Light Bold Italic"
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
font-size = 16

quick-terminal-position = top
quick-terminal-size = 40%,70%
quick-terminal-screen = mouse

keybind = global:ctrl+semicolon=toggle_quick_terminal
keybind = ctrl+l=clear_screen
{{ else if $ubuntuGnome -}}
font-size = 13
background-opacity = 0.92
keybind = ctrl+shift+d=toggle_window_decorations
{{ else -}}
font-size = 12
background-opacity = 0.95
keybind = ctrl+shift+d=toggle_window_decorations
{{ end -}}

{{/* Split navigation on every OS. On Linux it replaces Ghostty's
     Ctrl+Alt+arrows (GNOME switches workspaces with those) and its
     Ctrl+Shift+J (write screen to file). Ctrl+Enter no longer toggles
     fullscreen. On Linux, Ctrl+L in the shell clears the screen. */ -}}
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+enter=unbind

confirm-close-surface = false

theme = {{ if lookPath "noctalia" }}noctalia{{ else }}theme.conf{{ end }}

term=xterm-256color

command = /bin/zsh
shell-integration = detect

