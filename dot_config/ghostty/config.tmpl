window-padding-x = 4
window-padding-y = 6

{{/* Ghostty can't read GNOME's monospace font setting (it asks
     fontconfig for "monospace"), so it names the same font as the
     work-laptop playbook's gnome_monospace_font: JetBrainsMono Nerd Font
     Mono Light 12. Ubuntu GNOME differs only in opacity (0.92). */ -}}
{{ $ubuntuGnome := and (eq .chezmoi.os "linux") (eq (index .chezmoi.osRelease "id") "ubuntu") (lookPath "gnome-shell") -}}
font-family = "JetBrainsMono Nerd Font Mono"
font-style = "Light"
font-style-bold = "SemiBold"
font-style-italic = "Light Italic"
font-style-bold-italic = "Light Bold Italic"
{{ if eq .chezmoi.os "darwin" -}}
font-size = 16

quick-terminal-position = top
quick-terminal-size = 40%,70%
quick-terminal-screen = mouse

keybind = global:ctrl+semicolon=toggle_quick_terminal
keybind = ctrl+l=clear_screen
{{ else if $ubuntuGnome -}}
font-size = 12
background-opacity = 0.92
keybind = ctrl+shift+d=toggle_window_decorations
{{ else -}}
font-size = 12
background-opacity = 0.95
keybind = ctrl+shift+d=toggle_window_decorations
{{ end -}}

{{/* No Ghostty splits: panes come from the multiplexer (herdr, tmux),
     so these keys pass through to it. Ctrl+Shift+J would otherwise write
     the screen to a file; Ctrl+Enter would toggle fullscreen. On Linux,
     Ctrl+L in the shell clears the screen. */ -}}
keybind = ctrl+shift+j=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+enter=unbind
keybind = ctrl+enter=unbind

confirm-close-surface = false

theme = {{ if lookPath "noctalia" }}noctalia{{ else }}theme.conf{{ end }}

term=xterm-256color

command = /bin/zsh
shell-integration = detect

