export EDITOR=nvim

export COLOR_SCHEME=ayu

export LANG=en_US.UTF-8

{{- if eq .chezmoi.os "linux" }}
# First installed terminal wins; Ptyxis is the Ubuntu/GNOME default.
for _term in kitty ghostty ptyxis gnome-terminal; do
  if command -v "$_term" >/dev/null 2>&1; then
    export TERMINAL="$_term"
    break
  fi
done
unset _term

# Use the systemd user agent, except in an SSH session where a forwarded
# agent must be left alone. Ubuntu's ssh-agent.socket listens at
# openssh_agent; other distros' units use ssh-agent.socket.
if [ -z "$SSH_CONNECTION" ]; then
  if [ -S "$XDG_RUNTIME_DIR"/openssh_agent ]; then
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR"/openssh_agent
  else
    export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR"/ssh-agent.socket
  fi
{{- if not .isWSL }}

  # Ask for key passphrases with ksshaskpass, which can remember them in
  # KWallet. Only under a graphical session, so TTY logins keep the prompt.
  # GNOME needs nothing here: ssh's default askpass, /usr/bin/ssh-askpass, is
  # the GNOME prompt (ssh-askpass-gnome), used where there is no terminal.
  if [ -x /usr/bin/ksshaskpass ] && [ -n "$WAYLAND_DISPLAY$DISPLAY" ]; then
    export SSH_ASKPASS=/usr/bin/ksshaskpass
    export SSH_ASKPASS_REQUIRE=prefer
  fi
{{- end }}
fi

# Path Bit
export PATH=$HOME/.local/bin:$PATH

export PATH=$HOME/.local/share/npm/bin:$PATH

# node, npm and npx come from /snap/bin. Not /snap/node/current/bin: node run
# from there is unconfined, and Ubuntu's AppArmor then blocks the user
# namespaces Chrome's sandbox needs (mmdc / puppeteer: "No usable sandbox!").

export PATH="$HOME/go/bin:$PATH"

export PATH="$PATH:$HOME/.fzf/bin"

export PATH=$HOME/.cargo/bin:$PATH

export PATH=$HOME/.config/composer/vendor/bin:$PATH

export VIRSH_DEFAULT_CONNECT_URI="qemu:///system"

export COMPOSE_MENU=false
{{- end }}

if command -v bat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi

# Fzf config
export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS \
  --highlight-line \
  --info=inline-right \
  --ansi \
  --layout=reverse \
  --border=sharp \
  --color=border:{{ .colors.cyan }} \
  --color=fg:{{ .colors.foreground }} \
  --color=gutter:{{ .colors.black }} \
  --color=header:{{ .colors.yellow }} \
  --color=hl+:{{ .colors.bright_cyan }} \
  --color=hl:{{ .colors.bright_cyan }} \
  --color=info:{{ .colors.bright_black }} \
  --color=marker:{{ .colors.red }} \
  --color=pointer:{{ .colors.red }} \
  --color=prompt:{{ .colors.bright_cyan }} \
  --color=query:{{ .colors.foreground }}:regular \
  --color=scrollbar:{{ .colors.cyan }} \
  --color=separator:{{ .colors.yellow }} \
  --color=spinner:{{ .colors.red }} \
"

export FZF_CTRL_R_OPTS="--border-label='History Search'"
export FZF_ALT_C_OPTS="--border-label='Directory Search'"
export FZF_CTRL_T_OPTS="--border-label='File Search' --preview 'bat {}'"
export FZF_ALT_C_COMMAND='fd --type d --exclude .steam --hidden --follow . "$HOME"'
export FZF_CTRL_T_COMMAND='fd --hidden --type=file --exclude .steam --follow . "$HOME"'
export FZF_DEFAULT_COMMAND='fd --type file --follow --exclude .steam --hidden --color=always'
