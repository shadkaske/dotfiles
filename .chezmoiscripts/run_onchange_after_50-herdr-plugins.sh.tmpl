#!/usr/bin/env bash
# Link local herdr plugins. Re-runs when a plugin manifest changes, since
# herdr caches the manifest at link time.
# manifest hashes (re-link when one changes):
#   ssh: {{ include "dot_config/herdr/plugins/ssh/herdr-plugin.toml" | sha256sum }}
#   tab-numbers: {{ include "dot_config/herdr/plugins/tab-numbers/herdr-plugin.toml" | sha256sum }}
#   apps: {{ include "dot_config/herdr/plugins/apps/herdr-plugin.toml" | sha256sum }}

command -v herdr >/dev/null || exit 0

for dir in "$HOME"/.config/herdr/plugins/*/; do
  [[ -f "$dir/herdr-plugin.toml" ]] || continue
  herdr plugin link "${dir%/}" >/dev/null
done
