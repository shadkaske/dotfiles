{{- if and (eq .chezmoi.os "linux") (not .isWSL) -}}
#!/usr/bin/env bash
# Point Ptyxis (the Ubuntu/GNOME terminal) at the chezmoi palette. Its font
# follows GNOME's monospace font, set by the work-laptop playbook (gnome role).
# Re-runs when the color scheme changes.
# colors hash: {{ .colors | toJson | sha256sum }}
set -euo pipefail

command -v ptyxis >/dev/null && command -v gsettings >/dev/null || exit 0

uuid="$(gsettings get org.gnome.Ptyxis default-profile-uuid | tr -d "'")"
if [[ -z $uuid ]]; then
  # Ptyxis creates its first profile on first launch; create it ourselves
  uuid="$(tr -d '-' < /proc/sys/kernel/random/uuid)"
  gsettings set org.gnome.Ptyxis profile-uuids "['$uuid']"
  gsettings set org.gnome.Ptyxis default-profile-uuid "$uuid"
fi

gsettings set "org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$uuid/" palette chezmoi
{{ end -}}
