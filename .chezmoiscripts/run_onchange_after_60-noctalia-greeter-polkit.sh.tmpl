{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Install a polkit rule so Noctalia Shell can sync its appearance to
# noctalia-greeter without a password prompt. Re-runs when the rule changes.
set -euo pipefail

command -v noctalia-greeter-apply-appearance >/dev/null || exit 0

rule_file=/etc/polkit-1/rules.d/49-noctalia-greeter-sync.rules
rule=$(cat <<'EOF'
// Let {{ .chezmoi.username }} sync Noctalia Shell's appearance to the greeter without a password,
// but only from an active local session.
polkit.addRule(function(action, subject) {
    if (action.id == "org.noctalia.greeter.sync-appearance" &&
        subject.user == "{{ .chezmoi.username }}" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
EOF
)

if printf '%s\n' "$rule" | sudo cmp -s "$rule_file" - 2>/dev/null; then
  exit 0
fi

printf '%s\n' "$rule" | sudo install -m 644 -o root -g root /dev/stdin "$rule_file"
echo "Installed $rule_file"
{{ end -}}
